# Keep text files stable across Windows, macOS, Linux, and sandboxed builds.
* text=auto

*.css text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.pdf binary
*.zip binary
