---
layout: layouts/base.njk
permalink: /maps-and-lists/ancestor-table.html
title: Pedigree Catalog
pageHeading: Pedigree Catalog
subtitle: "One catalog for the direct Gurney line. Start with the quick view, then switch to detailed view for notables, places, land, and lineage status."
description: "Pedigree catalog for the direct Gurney line, with quick and detailed views driven by the current ancestor data."
bodyClass: ancestor-table-page catalog-page
activeNav: maps
updated: 25 April 2026
---

<div class="catalog-toolbar" data-catalog-controls>
  <div class="segmented-control" role="group" aria-label="Catalog view">
    <button type="button" class="is-active" data-catalog-mode="quick" aria-pressed="true">Quick view</button>
    <button type="button" data-catalog-mode="detailed" aria-pressed="false">Detailed view</button>
  </div>
  <p class="catalog-note">Fact sheets are rebuilt from the source Markdown. Research notes open the supplemental companion pages.</p>
</div>

<div class="catalog-table-wrap catalog-quick" data-catalog-table>
  <table class="data-table styled-table catalog-table">
    <colgroup>
      <col class="catalog-col-gen">
      <col class="catalog-col-name">
      <col class="catalog-col-geography">
      <col class="catalog-col-summary">
      <col class="catalog-col-detail catalog-col-notables">
      <col class="catalog-col-detail catalog-col-places">
      <col class="catalog-col-detail catalog-col-status">
      <col class="catalog-col-links">
    </colgroup>
    <thead>
      <tr>
        <th>Gen.</th>
        <th>Name &amp; Dates</th>
        <th>Geography</th>
        <th>Summary</th>
        <th class="catalog-detail-col">Notables</th>
        <th class="catalog-detail-col">Places &amp; Holdings</th>
        <th class="catalog-detail-col">Lineage Status</th>
        <th>Links</th>
      </tr>
    </thead>
    <tbody>
      {% for item in ancestors %}
        {% if item.type == "era" %}
          <tr class="era-row {{ item.cssClass }}">
            <td colspan="8">{{ item.label }}{% if item.dates %} <span class="era-dates">{{ item.dates }}</span>{% endif %}</td>
          </tr>
        {% elif item.type == "ancestor" %}
          <tr class="ancestor-row">
            <td class="gen-cell">{{ item.gen }}</td>
            <td class="name-cell">
              <span class="name">{{ item.name }}</span>
              {% if item.dates %}<span class="dates">{{ item.dates }}</span>{% endif %}
            </td>
            <td class="muted">{{ item.geography }}</td>
            <td class="summary-cell">{{ item.summary }}</td>
            <td class="muted catalog-detail-col">{{ item.notables }}</td>
            <td class="muted catalog-detail-col">
              {% if item.placeSummary %}<p class="place-summary">{{ item.placeSummary }}</p>{% endif %}
              {% if item.landHoldings and item.landHoldings != "—" %}<p>{{ item.landHoldings }}</p>{% endif %}
            </td>
            <td class="catalog-detail-col">
              {% set ls = item.lineageStatus | lower | replace(" ", "-") %}
              <span class="lineage-badge ls-{{ ls }}">{{ item.lineageStatus }}</span>
            </td>
            <td>
              {% if item.buttons and item.buttons.length %}
                <div class="btns">
                  {% for btn in item.buttons %}
                    <a href="{{ btn.url }}" class="btn-{{ btn.style }}">{{ btn.label }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

<p class="muted catalog-source-note"><em>Data source: generated from <code>data/ancestors v26.json</code>, <code>data/places.json</code>, <code>data/places_detail.json</code>, root fact-sheet Markdown, and root research companion Markdown.</em></p>

<script>
(() => {
  const table = document.querySelector("[data-catalog-table]");
  const buttons = Array.from(document.querySelectorAll("[data-catalog-mode]"));
  if (!table || !buttons.length) return;

  function setMode(mode) {
    const isDetailed = mode === "detailed";
    table.classList.toggle("catalog-quick", !isDetailed);
    table.classList.toggle("catalog-detailed", isDetailed);
    buttons.forEach(button => {
      const active = button.dataset.catalogMode === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", active ? "true" : "false");
    });
    try {
      window.localStorage.setItem("gurneyCatalogMode", mode);
    } catch (err) {}
  }

  buttons.forEach(button => {
    button.addEventListener("click", () => setMode(button.dataset.catalogMode));
  });

  let saved = "quick";
  try {
    saved = window.localStorage.getItem("gurneyCatalogMode") || "quick";
  } catch (err) {}
  setMode(saved === "detailed" ? "detailed" : "quick");
})();
</script>
