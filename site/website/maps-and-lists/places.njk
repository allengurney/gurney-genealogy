---
layout: layouts/base.njk
permalink: /maps-and-lists/places.html
title: Places Catalog
pageHeading: Places Catalog
subtitle: "Places connected to the Gurney pedigree, generated from the current structured places data."
description: "Places catalog for the Gurney genealogy library, linking places back to related ancestors and records."
bodyClass: explorer-page places-page
activeNav: maps
---

<div data-place-explorer>
  <header class="explorer-head explorer-head-with-stats">
    <div>
      <p class="explorer-crumbs explorer-page-title">Library / Places Catalog</p>
      <p class="explorer-subtitle">A place-first view of the same structured spine: addresses, churches, manors, regions, and sites tied back to ancestor records.</p>
    </div>
    <div class="stats-strip compact-stats">
      <div class="stat"><span class="label">Places</span><span class="value">{{ placesCatalog.length }}</span></div>
      <div class="stat"><span class="label">Linked records</span><span class="value">{{ siteStats.placeLinkCount }}</span></div>
      <div class="stat"><span class="label">Geocoded</span><span class="value">{{ siteStats.geocodedPlaceCount }}</span></div>
      <div class="stat"><span class="label">Place types</span><span class="value">{{ siteStats.placeTypeCount }}</span></div>
    </div>
  </header>

  <div class="catalog-toolbar place-region-toolbar">
    <div class="filter-group" role="group" aria-label="Region filter">
      <button type="button" class="is-active" data-place-region-filter="all">All</button>
      <button type="button" data-place-region-filter="north-america">North America</button>
      <button type="button" data-place-region-filter="england">England</button>
      <button type="button" data-place-region-filter="europe">Europe</button>
      <button type="button" data-place-region-filter="other">Other</button>
    </div>
  </div>

  <section class="place-list" aria-label="Places catalog">
    {% for place in placesCatalog %}
      <article class="place-row"
               data-place-row
               data-place-id="{{ place.placeId }}"
               data-place-region="{{ place.regionGroup }}"
               tabindex="0"
               role="button">
        <div class="place-marker"></div>
        <div class="place-main">
          <h2>{{ place.title }}</h2>
          <p>{{ place.shortDescription or place.longDescription }}</p>
          <div class="place-meta">
            {% if place.placeType %}<span>{{ place.placeType }}</span>{% endif %}
            {% if place.region %}<span>{{ place.region }}</span>{% endif %}
            {% if place.coordinatePrecision %}<span>{{ place.coordinatePrecision }} precision</span>{% endif %}
          </div>
        </div>
        <div class="place-media" aria-label="Place previews">
          {% if place.imageUrl %}
            <a class="place-thumb place-image-thumb"
               href="{{ place.imageUrl }}"
               target="_blank"
               rel="noopener"
               aria-label="Open image for {{ place.title }}"
               data-place-interactive>
              <img src="{{ place.imageUrl }}" alt="{{ place.imageTitle or place.title }}" loading="lazy">
            </a>
          {% endif %}
          {% if place.coordinate and place.coordinate.lat and place.coordinate.lng %}
            <div class="place-map-thumb"
                 data-place-map-thumb
                 data-place-interactive
                 data-lat="{{ place.coordinate.lat }}"
                 data-lng="{{ place.coordinate.lng }}"
                 data-place-id="{{ place.placeId }}"
                 data-place-title="{{ place.title }}">
              <button type="button" class="place-map-button" aria-label="Map actions for {{ place.title }}">
                <span class="place-mini-map" data-place-mini-map></span>
                <span class="place-map-attribution">&copy; OSM/CARTO</span>
              </button>
              <div class="place-map-popover" data-place-map-popover>
                <a href="https://www.google.com/maps/search/?api=1&amp;query={{ place.coordinate.lat }},{{ place.coordinate.lng }}" target="_blank" rel="noopener">Google Maps</a>
                <a href="/maps-and-lists/ancestor-map.html?place={{ place.placeId }}">Ancestor Map</a>
              </div>
            </div>
          {% endif %}
        </div>
        <div class="place-count">{{ place.ancestorCount }} link{% if place.ancestorCount != 1 %}s{% endif %}</div>
      </article>
    {% endfor %}
  </section>

  <div class="drawer-backdrop" data-place-backdrop></div>
  <aside class="detail-drawer place-drawer" data-place-drawer aria-hidden="true" aria-label="Place detail drawer">
    <button type="button" class="drawer-close" data-place-close aria-label="Close place">&times;</button>
    {% for place in placesCatalog %}
      <article class="detail-panel" data-place-panel="{{ place.placeId }}">
        <header class="detail-head">
          <div class="detail-eyebrow">{{ place.placeType or "Place" }}{% if place.coordinatePrecision %} / {{ place.coordinatePrecision }} precision{% endif %}</div>
          <h2 class="detail-name">{{ place.title }}</h2>
          {% if place.region %}<div class="detail-dates">{{ place.region }}</div>{% endif %}
          <div class="detail-actions">
            {% if place.researchUrl %}<a href="{{ place.researchUrl }}" class="btn primary">Place research</a>{% endif %}
            <a href="/maps-and-lists/ancestor-map.html" class="btn">Map</a>
            {% if place.siteUrl %}<a href="{{ place.siteUrl }}" class="btn">{{ place.siteLabel or "Site reference" }}</a>{% endif %}
          </div>
        </header>
        <div class="detail-body">
          {% if place.imageUrl %}
            <figure class="place-image">
              <img src="{{ place.imageUrl }}" alt="{{ place.imageTitle or place.title }}">
              {% if place.imageTitle %}<figcaption>{{ place.imageTitle }}</figcaption>{% endif %}
            </figure>
          {% endif %}
          {% if place.longDescription %}<p class="detail-summary">{{ place.longDescription }}</p>{% endif %}
          {% if place.streetAddress or place.aliases.length or place.roles.length %}
            <section class="detail-section">
              <h4>Place details</h4>
              <ul>
                {% if place.streetAddress %}<li>Address: {{ place.streetAddress }}</li>{% endif %}
                {% if place.aliases.length %}<li>Also known as: {{ place.aliases | join(", ") }}</li>{% endif %}
                {% if place.roles.length %}<li>Roles: {{ place.roles | join(", ") }}</li>{% endif %}
              </ul>
            </section>
          {% endif %}
          {% if place.extantStatus or place.extantStatusDescription %}
            <section class="detail-section">
              <h4>Site notes</h4>
              <ul>
                {% if place.extantStatus %}<li>Extant status: {{ place.extantStatus }}{% if place.extantStatusDescription %} - {{ place.extantStatusDescription }}{% endif %}</li>{% endif %}
              </ul>
            </section>
          {% endif %}
          {% if place.ancestorLinks and place.ancestorLinks.length %}
            <section class="detail-section">
              <h4>Related ancestors</h4>
              <ul class="place-ancestor-links">
                {% for ancestor in place.ancestorLinks %}
                  <li>
                    {% if ancestor.url %}<a href="{{ ancestor.url }}">{{ ancestor.gen }} {{ ancestor.name }}</a>{% else %}<span>{{ ancestor.gen }} {{ ancestor.name }}</span>{% endif %}
                    {% if ancestor.displayLineageStatus %}<span class="lineage-note">{{ ancestor.displayLineageStatus }}</span>{% endif %}
                    {% if ancestor.role %}<span class="place-role">{{ ancestor.role }}</span>{% endif %}
                  </li>
                {% endfor %}
              </ul>
            </section>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </aside>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="/assets/pedigree-explorer.js"></script>
<script src="/assets/place-thumbnails.js"></script>
