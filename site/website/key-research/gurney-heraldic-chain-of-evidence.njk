.heraldic-chain{--parchment:#f3ead3;--parchment2:#ece0c2;--ink:#2b2620;--muted:#695b43;--rule:#c9b68c;--visit:#2e3d63;--church:#8c2b2b;--homes:#3c6b47;--early:#1f6f6a;--glass:#a6781f;--arms:#a6281f;color:var(--ink)}
.heraldic-chain .intro{max-width:1120px;margin:0 auto 1.1rem;font-family:Inter,Arial,sans-serif;color:#5b6575;font-size:.96rem;line-height:1.55}
.heraldic-chain .intro strong{color:var(--ink)}
.heraldic-scroll{overflow:auto;padding:14px;border:1px solid #d2c4a2;border-radius:18px;background:radial-gradient(120% 120% at 50% 40%,#221d17,#0e0c0a);box-shadow:0 18px 44px rgba(29,33,41,.16)}
.chain-board{min-width:1250px;padding:34px 34px 28px;border-radius:12px;background:radial-gradient(140% 120% at 18% 8%,#f8f0dc 0%,var(--parchment) 42%,var(--parchment2) 100%);box-shadow:inset 0 0 0 10px rgba(255,255,255,.28),inset 0 0 0 12px rgba(150,124,78,.22);font-family:"Crimson Pro",Georgia,serif}
.chain-title{display:grid;grid-template-columns:370px 1fr;gap:28px;align-items:start;margin-bottom:26px}
.chain-title h2{font-size:2.55rem;line-height:1.02;margin:0;color:var(--ink)}
.chain-title p{font-size:1.35rem;line-height:1.38;margin:.35rem 0 0;color:var(--muted)}
.chain-key{display:flex;gap:16px;flex-wrap:wrap;margin-top:12px;font-family:Inter,Arial,sans-serif;font-size:.82rem;color:var(--muted)}
.chain-key span{display:inline-flex;align-items:center;gap:7px}
.chain-key span::before{content:"";width:13px;height:13px;border-radius:50%;background:var(--arms);box-shadow:0 0 0 3px var(--parchment)}
.chain-key span:nth-child(2)::before{background:transparent;border:2px solid var(--glass);box-shadow:none}
.chain-head,.chain-row{display:grid;grid-template-columns:370px repeat(5,1fr);gap:10px;align-items:stretch}
.chain-head{margin-bottom:10px}
.evidence-head{text-align:center;padding:0 10px 12px;border-bottom:2px solid currentColor}
.evidence-head h2{font-size:1.35rem;line-height:1.05;margin:.15rem 0 .55rem;color:currentColor}
.evidence-head p{font-size:1.02rem;line-height:1.26;margin:0;color:var(--ink)}
.evidence-icon{width:42px;height:42px;margin:0 auto .45rem;border:2px solid currentColor;border-radius:50%;position:relative}
.evidence-icon::after{content:"";position:absolute;left:11px;right:11px;top:19px;border-top:2px solid currentColor}
.visitations{color:var(--visit)}.west{color:var(--church)}.homes{color:var(--homes)}.walsingham{color:var(--glass)}.recurring{color:var(--arms)}
.chain-row{min-height:58px;border-top:1px solid rgba(105,91,67,.24)}.chain-row:nth-child(even){background:rgba(120,96,52,.055)}
.ancestor-cell{display:flex;align-items:center;gap:14px;padding:6px 10px}
.gen{min-width:58px;text-align:center;padding:.28rem .45rem;border:1px solid var(--rule);border-radius:8px;background:rgba(43,38,32,.055);font-weight:700;color:var(--muted);font-size:1.05rem}
.person strong{display:block;font-size:1.25rem;line-height:1.05;color:var(--ink);white-space:nowrap}.person em{display:block;font-size:1rem;line-height:1.15;color:var(--muted);white-space:nowrap}.person em.unknown{color:#8c7c5b}
.evidence-cell{position:relative;display:flex;align-items:center;justify-content:center}.evidence-cell.active::before{content:"";position:absolute;top:-1px;bottom:-1px;width:56px;border-left:1px solid color-mix(in srgb,currentColor 34%,transparent);border-right:1px solid color-mix(in srgb,currentColor 34%,transparent);background:color-mix(in srgb,currentColor 15%,transparent);border-radius:8px}
.evidence-cell.dot span{position:relative;z-index:1;width:20px;height:20px;border-radius:50%;background:currentColor;box-shadow:0 0 0 4px var(--parchment),0 1px 2px rgba(0,0,0,.25)}.evidence-cell.open span{background:transparent;border:3px solid currentColor;box-shadow:0 0 0 4px var(--parchment)}
.evidence-cell.early{color:var(--early)}.evidence-cell.early::after{content:"Early arms & seal";position:absolute;left:calc(50% + 38px);top:50%;transform:translateY(-50%);font-family:Inter,Arial,sans-serif;font-size:.74rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--early);white-space:nowrap}
.chain-summary{max-width:1120px;margin:1.2rem auto 0;padding:1rem 1.1rem;border:1px solid #d9cfbf;border-radius:14px;background:#fffaf0;font-family:Inter,Arial,sans-serif;font-size:.94rem;line-height:1.58;color:#3d3229}
.chain-summary h2{margin:0 0 .45rem;font-family:"Crimson Pro",Georgia,serif;font-size:1.35rem;color:var(--ink)}.chain-summary ul{margin:.35rem 0 0 1.2rem}
