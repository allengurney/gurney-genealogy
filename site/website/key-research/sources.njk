---
layout: layouts/base.njk
permalink: /key-research/sources.html
title: Sources
pageHeading: Sources
subtitle: "Primary and core reference sources used in the Gurney genealogy library."
description: "Canonical source registry for the Gurney genealogy library, generated from data/sources.json."
bodyClass: explorer-page sources-page
activeNav: research
---

<header class="explorer-head explorer-head-with-stats">
  <div>
    <p class="explorer-crumbs explorer-page-title">Library / Sources</p>
    <p class="explorer-subtitle">A generated bibliography of the source registry behind the fact sheets, case files, research notes, and structured data.</p>
  </div>
  <div class="stats-strip compact-stats">
    <div class="stat" title="Total source registry entries — every cited source tracked in the library, whether the artefact is held locally or only referenced externally."><span class="label">Sources</span><span class="value">{{ sourceStats.sourceCount }}</span></div>
    <div class="stat" title="Full text of non-copyright works, text extracts, primary source imagery, and other media in the genealogy library."><span class="label">Library holdings</span><span class="value">{{ sourceStats.libraryHoldingsCount }}</span></div>
    <div class="stat" title="Sources reachable through an external URL — a publisher, archive, or institutional host page."><span class="label">External links</span><span class="value">{{ sourceStats.externalLinkCount }}</span></div>
    <div class="stat" title="Sources with a validation note in sources/validations/ recording what was examined and how identity was confirmed."><span class="label">Validations</span><span class="value">{{ sourceStats.validationCount }}</span></div>
  </div>
</header>

<section class="sources-list" aria-label="Source registry">
  {% for source in sourcesCatalog %}
    <article class="source-card" id="{{ source.sourceId }}">
      <div class="source-id">{{ source.sourceId }}</div>
      <h2>{{ source.shortTitle }}</h2>
      {% if source.citation %}<p class="source-citation">{{ source.citation }}</p>{% endif %}
      <dl class="source-meta">
        {% if source.archive %}<dt>Archive</dt><dd>{{ source.archive }}</dd>{% endif %}
        {% if source.corpusStatus %}<dt>Corpus</dt><dd>{{ source.corpusStatus }}</dd>{% endif %}
        {% if source.corpusPath %}<dt>Corpus path</dt><dd><code>{{ source.corpusPath }}</code></dd>{% endif %}
        {% if source.mediaPath %}<dt>Media path</dt><dd><code>{{ source.mediaPath }}</code></dd>{% endif %}
        {% if source.validationPath %}<dt>Validation</dt><dd><code>{{ source.validationPath }}</code></dd>{% endif %}
      </dl>
      {% if source.notes %}<p class="source-notes">{{ source.notes }}</p>{% endif %}
      {% if source.url %}<a class="btn" href="{{ source.url }}" target="_blank" rel="noopener">Open source</a>{% endif %}
    </article>
  {% endfor %}
</section>
