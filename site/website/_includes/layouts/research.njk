<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}Gurney Genealogy Library</title>
  {% include "partials/favicon-links.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/explorer.css">
  <link rel="stylesheet" href="/assets/refactor.css">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
</head>
<body class="design-refresh {{ bodyClass }}">

  {% include "partials/siteheader.njk" %}

  <main class="page-wrap">
    <article class="page-card">
      <div class="page-body">
        <div class="doc-content">
          <p class="research-companion-disclaimer">This research companion is provided as-is and contains information supplementary to the fact sheet and other WIP research.</p>
          {{ content | safe }}
        </div>
      </div>
    </article>
  </main>

  {% include "partials/sitefooter.njk" %}

</body>
</html>
