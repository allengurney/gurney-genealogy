<!DOCTYPE html>
<html lang="en">
<head>
  {% set metaTitle = seoTitle or title %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if metaTitle %}{{ metaTitle }} | {% endif %}Gurney Genealogy Library</title>
  {% include "partials/favicon-links.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/explorer.css">
  <link rel="stylesheet" href="/assets/refactor.css">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta property="og:title" content="{{ metaTitle }} | Gurney Genealogy Library">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:type" content="article">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | json | safe }},
    "name": {{ title | json | safe }},
    "description": {{ description | json | safe }},
    "url": {{ (site.url + page.url) | json | safe }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "Gurney Genealogy Library",
      "url": {{ (site.url + "/") | json | safe }}
    },
    "author": {
      "@type": "Person",
      "name": "Allen Gurney"
    }
  }
  </script>
</head>
<body class="design-refresh {{ bodyClass }}">

  {% include "partials/siteheader.njk" %}

  <main class="page-wrap">
    <article class="page-card">
      <div class="page-body">
        <div class="doc-content">
          <p class="research-companion-disclaimer">These research notes are provided as-is and contain supplementary working research.</p>
          {{ content | safe }}
        </div>
      </div>
    </article>
  </main>

  {% include "partials/sitefooter.njk" %}

</body>
</html>
