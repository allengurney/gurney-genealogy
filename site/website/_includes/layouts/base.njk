<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Gurney Genealogy Library</title>
  {% include "partials/favicon-links.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/explorer.css">
  <link rel="stylesheet" href="/assets/refactor.css">
  <link rel="stylesheet" href="/assets/phase2.css">
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <meta property="og:title" content="{{ title }} | Gurney Genealogy Library">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:type" content="article">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
</head>
<body class="design-refresh {{ bodyClass }}">

  {% include "partials/siteheader.njk" %}

  <main class="page-wrap">
    <article class="page-card">
      <div class="page-head{% if factsheetNav %} page-head-with-gen-nav{% endif %}">
        {% if factsheetNav %}
          <div class="page-head-row">
            <h1>{{ pageHeading | safe }}</h1>
            <nav class="generation-nav" aria-label="Generation navigation">
              {% if factsheetNav.later %}
                <a class="gen-link gen-prev" href="{{ factsheetNav.later.url }}" title="Later generation: {{ factsheetNav.later.label }}">&larr;</a>
              {% else %}
                <span class="gen-link is-disabled">&larr;</span>
              {% endif %}
              <span class="gen-current">Generation {{ factsheetNav.current.genDisplay }}</span>
              {% if factsheetNav.earlier %}
                <a class="gen-link gen-next" href="{{ factsheetNav.earlier.url }}" title="Earlier generation: {{ factsheetNav.earlier.label }}">&rarr;</a>
              {% else %}
                <span class="gen-link is-disabled">&rarr;</span>
              {% endif %}
            </nav>
          </div>
        {% else %}
          <h1>{{ pageHeading | safe }}</h1>
        {% endif %}
        {% if subtitle %}<p>{{ subtitle }}</p>{% endif %}
        {% if researchCompanion %}
          <p class="page-action-row"><a class="page-action-link" href="{{ researchCompanion.url }}">View research companion</a></p>
        {% endif %}
      </div>
      <div class="page-body">
        <div class="doc-content">
          {{ content | safe }}
        </div>
      </div>
    </article>
  </main>

  {% include "partials/sitefooter.njk" %}

</body>
</html>
