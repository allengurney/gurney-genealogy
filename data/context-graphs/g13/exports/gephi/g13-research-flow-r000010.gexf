      <node id="G13-RI-000018" label="Admitted Weymouth inhabitant (c. 1638/9-1642/4)">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000018" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="research_finding" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="high" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="John Gurney was an admitted, resident inhabitant of Weymouth c. 1638/9-c. 1642/4: early-Massachusetts town land divisions went only to admitted inhabitants, so his three original East/Mill-Field grants mark him as a recognised member of the Weymouth community before his removal to Braintree." />
          <attvalue for="date_summary" value="event: c. 1638/9-c. 1642/4" />
          <attvalue for="chronology_key" value="1640.0" />
          <attvalue for="source_count" value="0" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="1" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000019" label="Manuscript Land Grants book: John original grantee of 3 parcels">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000019" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="source_evidence" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="high" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="The Weymouth proprietors' manuscript Land Grants book records John Gurney as original grantee of three parcels - two East Field lots (ms pp. 12, 23, under Robert Randoll and Nathaniel Addames) and one Mill Field lot (ms p. 31, under Thomas Richardes), about eight acres in all - each 'first granted/given to John Gurny/Gurnie.'" />
          <attvalue for="source_count" value="1" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="0" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000020" label="MBCR 2:79 - 1644 £5 'Mr Ginner' bill (Gurny + Lake)">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000020" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="source_evidence" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="high" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="The Massachusetts Bay colony accounts for the General Court session beginning 30 October 1644 record: 'John Gurny his byl for 3. 16. 4d &amp; Tho: Lake his note for 1. 3. 8d are accepted for £5 fro Mr Ginner.'" />
          <attvalue for="date_summary" value="event: session beginning 30 October 1644" />
          <attvalue for="chronology_key" value="1644.0" />
          <attvalue for="source_count" value="1" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="0" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000021" label="Credit tie to Rev. Thomas Jenner, Weymouth's minister">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000021" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="research_finding" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate-high" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="John Gurney held a credit tie to Rev. Thomas Jenner ('Mr Ginner'), Weymouth's minister 1636-1640: the 1644 colony accounts accepted his bill and Thomas Lake's note as the £5 Jenner owed. The purpose of Gurney's bill is unstated - not evidence of tailoring, military supply, or a 1641/2 transaction." />
          <attvalue for="date_summary" value="event: documented 30 October 1644 (Jenner's Weymouth ministry 1636-1640)" />
          <attvalue for="chronology_key" value="1644.0" />
          <attvalue for="source_count" value="2" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="1" />
          <attvalue for="outgoing_relation_count" value="0" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000022" label="Weymouth associates: Ludden, Porter, Goodman King">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000022" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="research_finding" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="John Gurney's documented Weymouth associates were fellow townsmen - his 1641 gunpowder-fine co-petitioners James Ludden and Richard Porter (Porter a 1635 Weymouth settler) and, persisting to his 1663 estate, the creditor 'Goodman King of Waymouth.'" />
          <attvalue for="date_summary" value="event: 1641-1663 (gunpowder co-petition to 1663 estate debt)" />
          <attvalue for="chronology_key" value="1641.0" />
          <attvalue for="source_count" value="3" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="1" />
          <attvalue for="outgoing_relation_count" value="0" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000023" label="Negative: no active military service">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000023" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="negative_result" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="No record places John Gurney in active military service: the 1641 powder fine reflects only the ordinary readiness obligation, and a Gurn-variant sweep of the colony military/court records plus a full read of the printed colony records and the Military Company roll (1637-1652) finds him on no campaign, officer, volunteer, or membership list." />
          <attvalue for="source_count" value="3" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="0" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
