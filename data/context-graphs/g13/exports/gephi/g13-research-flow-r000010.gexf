      <node id="G13-RI-000016" label="Recognised standing in the Braintree community">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000016" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="research_finding" />
