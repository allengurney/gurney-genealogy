          <attvalue for="research_unit_id" value="g13-colonial-arrival-chronology" />
          <attvalue for="research_unit_title" value="Colonial arrival chronology" />
          <attvalue for="statement" value="The petition's image-verified &quot;Richard Porter of Weymouth&quot; reading shifts weight from the printed order's &quot;John Porter,&quot; making John Gurney's cleanest 1641 associate a Weymouth/Hull-company comparator rather than a Hingham/Salem Porter." />
          <attvalue for="source_count" value="2" />
          <attvalue for="entity_count" value="1" />
          <attvalue for="incoming_relation_count" value="0" />
