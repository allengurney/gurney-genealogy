      <node id="G13-RI-000007" label="Porter forename: petition 'Richard … of Weymouth' vs printed 'John'">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000007" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="analysis" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
