      <node id="G13-RI-000011" label="Tyng farm lease, 1647–1662 (continuous tenancy)">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000011" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="source_evidence" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="high" />
          <attvalue for="research_unit_id" value="g13-colonial-braintree-community" />
          <attvalue for="research_unit_title" value="Colonial Braintree community" />
          <attvalue for="statement" value="In 1647 William Tyng leased John Gurney a 45-acre Braintree farm for ten years; John continued to lease it from Tyng's daughters Bethia and Mercy until 1662, and the same farm is recorded in the 1653 Tyng inventory and the 28 March 1661 estate-division indenture." />
          <attvalue for="date_summary" value="event: 1647–1662" />
          <attvalue for="chronology_key" value="1654.5" />
          <attvalue for="source_count" value="3" />
          <attvalue for="entity_count" value="3" />
          <attvalue for="incoming_relation_count" value="2" />
          <attvalue for="outgoing_relation_count" value="2" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
      <node id="G13-RI-000012" label="Principal Braintree land was the leased Tyng farm (future Adams seat)">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000012" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="research_finding" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate-high" />
          <attvalue for="research_unit_id" value="g13-colonial-braintree-community" />
          <attvalue for="research_unit_title" value="Colonial Braintree community" />
          <attvalue for="statement" value="John Gurney's principal Braintree landholding was leasehold, not freehold: the Tyng farm he held continuously c. 1647–1662 was a tenancy, and the northern part of 'the Gurney farm' later became the Adams family seat (the Old House, Quincy)." />
          <attvalue for="source_count" value="1" />
          <attvalue for="entity_count" value="3" />
          <attvalue for="incoming_relation_count" value="2" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="1" />
        </attvalues>
      </node>
      <node id="G13-RI-000013" label="1661/2 Gurney–Thayer deed ('John Gurney, tailor')">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000013" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="source_evidence" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="high" />
          <attvalue for="research_unit_id" value="g13-colonial-braintree-community" />
          <attvalue for="research_unit_title" value="Colonial Braintree community" />
          <attvalue for="statement" value="On 12 February 1661/2 &quot;John Gurney, tailor&quot; conveyed to Richard Thayer, for £14, a Braintree house and orchard, a five-acre Monatiquot-River parcel, and an adjoining half-acre; possession given 16 April 1662, signed by mark, witnessed by Peter Brackett and John Rockwell." />
          <attvalue for="date_summary" value="event: 12 February 1661/2 (possession 16 April 1662)" />
          <attvalue for="chronology_key" value="1662.0" />
          <attvalue for="source_count" value="2" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="1" />
          <attvalue for="outgoing_relation_count" value="2" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="1" />
        </attvalues>
      </node>
      <node id="G13-RI-000014" label="Two distinct Braintree properties: leased Tyng farm vs. Monatiquot freehold">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000014" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="analysis" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate-high" />
          <attvalue for="research_unit_id" value="g13-colonial-braintree-community" />
          <attvalue for="research_unit_title" value="Colonial Braintree community" />
          <attvalue for="statement" value="John held two distinct Braintree properties in his final years — the leased Tyng farm (the future Adams seat) and his own Monatiquot-River freehold sold to Thayer in 1661/2 — so the 'Gurney farm' of local tradition and his personal homestead are separate parcels." />
          <attvalue for="source_count" value="0" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="0" />
          <attvalue for="outgoing_relation_count" value="3" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
