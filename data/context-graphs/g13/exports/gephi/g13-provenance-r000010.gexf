      <node id="G13-RI-000023" label="Negative: no active military service">
        <attvalues>
          <attvalue for="record_id" value="G13-RI-000023" />
          <attvalue for="node_type" value="research_item" />
          <attvalue for="item_kind" value="negative_result" />
          <attvalue for="status" value="active" />
          <attvalue for="review_state" value="human_reviewed" />
          <attvalue for="visibility" value="repo_only" />
          <attvalue for="confidence_label" value="moderate" />
          <attvalue for="research_unit_id" value="g13-colonial-weymouth-community" />
          <attvalue for="research_unit_title" value="Colonial Weymouth community" />
          <attvalue for="statement" value="No record places John Gurney in active military service: the 1641 powder fine reflects only the ordinary readiness obligation, and a Gurn-variant sweep of the colony military/court records plus a full read of the printed colony records and the Military Company roll (1637-1652) finds him on no campaign, officer, volunteer, or membership list." />
          <attvalue for="source_count" value="3" />
          <attvalue for="entity_count" value="2" />
          <attvalue for="incoming_relation_count" value="0" />
          <attvalue for="outgoing_relation_count" value="1" />
          <attvalue for="marker_count" value="1" />
          <attvalue for="publication_count" value="0" />
        </attvalues>
      </node>
