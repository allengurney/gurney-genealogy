// Pour passer de l'onglet recherche simple à l'onglet recherche avancée

document.body.addEventListener("click", (event) => {
if (event.target.classList.contains("onglet")) {
	let targetTab = event.target.getAttribute("target");
	document.querySelectorAll(".onglet").forEach(button => {
		button.classList.remove("active");
		
	});
	event.target.classList.add("active");
	document.querySelector("#simple-search-section").style.display = "none";
	document.querySelector("#simple-search-section").classList.remove("active");
	document.querySelector("#search-section").style.display = "none";
	document.querySelector("#search-section").classList.remove("active");
	document.querySelector("#" + targetTab).style.display = "block";
	document.querySelector("#" + targetTab).classList.add("active");
}

// pour retirer une proposition dans rechercher
if (event.target.classList.contains("closeBtn")) {
    event.target.parentNode.remove();
}
});


// On commence la recherche

const currentFocusList = new Map();

document.addEventListener("DOMContentLoaded", function () {
    if (document.querySelector("#search-page")) {
        enableSearch();
    }
});

function enableSearch() {	
	simpleSearchButton = document.querySelector("#simpleSearchButton");
	searchButton = document.querySelector("#searchButton");

	// en appuyant sur Entrée
	document.addEventListener("keydown", event => {
		if(event.key==='Enter' && document.querySelector("#simple-search-section").classList.contains("active")) {
			prepareSimpleSearch();
		} else if(event.key==='Enter' && document.querySelector("#search-section").classList.contains("active")){
			prepareSearch();
		}
	})

// Pour lancer la recherche avec un clic : recherche simple ou avancée
    simpleSearchButton.addEventListener("click", event => {
		prepareSimpleSearch();
	})

    searchButton.addEventListener("click", event => {
		prepareSearch();
	})

// On peut pas renseigner en même temps une date seule et un interval
	document.querySelectorAll(".date-input").forEach(input => input.addEventListener("click", event => {
		if(input.getAttribute("id") == 'search-date') {
			document.getElementById('search-date').classList.remove("disabled");
			document.getElementById('search-date-from').value = "";
			document.getElementById('search-date-from').classList.add("disabled");
			document.getElementById('search-date-to').value = "";
			document.getElementById('search-date-to').classList.add("disabled");
		} else {
			document.getElementById('search-date').value = "";
			document.getElementById('search-date').classList.add("disabled");
			document.getElementById('search-date-from').classList.remove("disabled");
			document.getElementById('search-date-to').classList.remove("disabled");
		}
	}));
	
// pour réinitialiser les paramètres
document.querySelector("#reinitButton").addEventListener("click", event => {
    reinitForm();
})
};

function reinitForm() {
    document.querySelectorAll(".search-input").forEach(input => {
        input.value = "";
    })
    document.querySelectorAll(".suggested-value").forEach(sugVal => {
        sugVal.remove();
    })
    document.querySelectorAll(".coll-input").forEach(coll => {
        coll.checked = "" ;
    })
    document.getElementById('search-date').classList.remove('disabled');
    document.getElementById('search-date-from').value = "";
    document.getElementById('search-date-to').value = "";
    document.getElementById('search-date-from').classList.add('disabled');
    document.getElementById('search-date-to').classList.add('disabled');
    document.querySelector("#tei-search-dig-cb").checked = "";
    document.querySelector("#search-index-cb").checked = "";
};
		

// La recherche plein texte
function prepareSimpleSearch() {
	let searchText = document.querySelector(".simple-search-input").value ;			
	searchParams=document.querySelector(".simple-search-input").value ;
	// Si rien n'a été renseigné, on alerte l'utilisateur. Sinon, on lance la requête puis on affiche les résultats
	if(searchParams.length === 0) {
		alert("Recherche vide");
	} else {
		executeQuerySimple("scripta", searchParams, 5000).then(results => {
			displayResults(results.hits.hits, "true", searchText)
		});
	}
};

// La recherche avancée
function prepareSearch() {
    let searchParams = []

    // On crée un objet json pour chaque critère renseigné par l'utilisateur
    document.querySelectorAll(".search-input").forEach((criteria) => {
        if (criteria.parentNode.querySelector(".suggested-value")) {
            let shouldArray = []
            criteria.parentNode.querySelectorAll(".suggested-value").forEach((sugVal) => {
                let criteriaKey = sugVal.dataset.index;
                let criteriaValue = sugVal.dataset.value;
                let criteriaObject = Object.fromEntries([[criteriaKey, criteriaValue]]);
                let shouldParam = Object.fromEntries([["match_phrase", criteriaObject]]);
                shouldArray.push(shouldParam)
            })
            let shouldParams = Object.fromEntries([["should", shouldArray]]);
            let boolParam = Object.fromEntries([["bool", shouldParams]]);
            searchParams.push(boolParam);
        } else if (criteria.dataset.index == "date" && criteria.value.trim() !== '') {
            let criteriaKey = "date_range";
            let criteriaValue = criteria.value;
            let criteriaObject = Object.fromEntries([[criteriaKey, criteriaValue]]);
            let searchParam = Object.fromEntries([["term", criteriaObject]]);
            searchParams.push(searchParam);
        } else if (criteria.value.trim() !== '') {
            let criteriaKey = criteria.dataset.index;
            let criteriaValue = criteria.value;
            let criteriaObject = Object.fromEntries([["query", criteriaValue], ["default_field", criteriaKey]]);
            let searchParam = Object.fromEntries([["query_string", criteriaObject]]);
            searchParams.push(searchParam);
        }
    })

    // Les ouvrages numérisés
    if (document.querySelector("#tei-search-dig-cb").checked) {
        let criteriaObject = Object.fromEntries([["digitalized", "true"]]);
        let searchParam = Object.fromEntries([["match_phrase", criteriaObject]]);
        searchParams.push(searchParam);
    }

    if (document.querySelector("#search-index-cb").checked) {
        let criteriaObject = Object.fromEntries([["index", "true"]]);
        let searchParam = Object.fromEntries([["match_phrase", criteriaObject]]);
        searchParams.push(searchParam);
    }

    // Les dates
    if (document.querySelector("#search-date-from").value.trim() != '' || document.querySelector("#search-date-to").value.trim() != '') {
        let start = document.querySelector("#search-date-from").value.trim() == '' ? "-10000" : document.querySelector("#search-date-from").value;
        let end = document.querySelector("#search-date-to").value.trim() == '' ? "10000" : document.querySelector("#search-date-to").value;
        let interval = Object.fromEntries([['gte', start], ['lte', end]]);
        let criteriaObject = Object.fromEntries([["date", interval]]);
        let searchParam = Object.fromEntries([["range", criteriaObject]]);
        searchParams.push(searchParam);
    }

    // Si rien n'a été renseigné, on alerte l'utilisateur. Sinon, on lance la requête puis on affiche les résultats
    if (searchParams.length === 0) {
        alert("Renseignez au moins un critère de recherche");
    } else {
        executeQueryAll("scripta", searchParams, 5000).then(results => {
            displayResults(results.hits.hits);
        });
    }
};

async function executeQuerySimple(searchedIndex, searchParams, length) {
    // baseQuery = "http://localhost:9200/" + searchedIndex + "/_search"
    // localhost à remplacer pour mise en ligne
    baseQuery = searchedIndex + "/_search"
    let queryParameters = { 
            track_total_hits: true,
        query: {
            query_string: {
                query: searchParams,
                "default_operator": "and",
                "analyze_wildcard": true,
                "allow_leading_wildcard": true,
                "fields": ["content"],
            }
            },
            "highlight": {
                "fields": {
                    "content": {"pre_tags" : ["<span class='mark'>"], "post_tags" : ["</span>"]}
                }
                },
        sort: [
            {"order": "asc"}
        ],
        size: length,
        from: 0
    }
    
    const queryInit= {
        method: "POST",
        headers:{
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(queryParameters)
    };

    const response = await fetch(baseQuery,queryInit);
    let results = await response.json();
    return results
};
    
async function executeQueryAll(searchedIndex, searchParams, length) {
    // baseQuery = "http://localhost:9200/" + searchedIndex + "/_search"
    // localhost à remplacer pour mise en ligne
    baseQuery = searchedIndex + "/_search"
    let queryParameters = {
        track_total_hits: true,
        query: {
            bool: {
                must: searchParams
            }
        },
        size: length,
        from: 0
    }

    const queryInit = {
        method: "POST",
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(queryParameters)
    };

    const response = await fetch(baseQuery, queryInit);
    let results = await response.json();
    return results
};

function displayResults(results, highlightMode, searchText) {
    let resultsContainer = document.querySelector("#search-results")
    resultsContainer.innerHTML = ""

    let nbResults = results.length;
    let nbResultsNode = document.createElement("h1");
    if (nbResults < 2) {
        nbResultsNode.innerHTML = nbResults + " r&eacute;sultat";
    } else {
        nbResultsNode.innerHTML = nbResults + " r&eacute;sultats";
    }
    resultsContainer.append(nbResultsNode);

    let groupedByActe = Array.from(groupResults(results, "num"));

    groupedByActe.forEach(categorie => {
        let catContainer = document.createElement("div");
        let catHead = document.createElement("span");
        catHead.setAttribute("class", "titre-result");
        let resultList = document.createElement("span");
        resultList.setAttribute("class", "txt-result");
        let resultAna = document.createElement("p");
        resultAna.setAttribute("class", "ana-result");
        // let resultDoc = document.createElement("p");
        // resultDoc.setAttribute("class", "doc-result");

        let nbResultsCat = categorie.items.length;
        catHead.innerHTML = "N° " + categorie.items[0]._source.num + " : ";
        let anaLongue = categorie.items[0]._source.analyse
        let anaTableau = anaLongue.split(' ');
        let dixPremiersMots = anaTableau.slice(0, 50);
        let anaCourte = dixPremiersMots.join(' ');
        resultAna.innerHTML = anaCourte + " […]";

        catContainer.append(catHead);
        catContainer.append(resultList);
        catContainer.append(resultAna);
        // catContainer.append(afficheResult);

        categorie.items.forEach(entry => {
            let resultText = entry._source.dateTxt + " - " + entry._source.genre + " - " + entry._source.typeActe + " - Auteur(s) : " + entry._source.auteurTxt + " - Bénéficiaire(s) : " + entry._source.benefTxt;
            let resultNode = document.createElement("span");
            let resultLink = document.createElement("a");
            let resultLinkTarget = "/" + projectId + "/doc/" + entry._id + ".html";
            resultLinkTarget += (highlightMode ? "?search=" + searchText : "")
            resultLink.setAttribute("href", resultLinkTarget);
            resultLink.innerHTML = resultText;

            resultNode.append(resultLink);
            resultList.append(resultNode);

            let entryHighlight = entry.highlight
            for (const property in entryHighlight) {
                let type = property;
                //appel d'une fonction pour l’ajout des […] 
                let texte = traitementTxt(entry, type)
                let afficheResult = document.createElement("p")
                const afficheResultAtt = document.createAttribute("class");
                afficheResultAtt.value = "doc-result"
                afficheResult.setAttributeNode(afficheResultAtt)
                afficheResult.innerHTML = texte
                catContainer.append(afficheResult);
            }


        })
        resultsContainer.append(catContainer);
    })
};

function traitementTxt(entry,type) {
	titre = "<em>" + type.replace("_"," ") + "</em> : "
	type = entry.highlight[type].join(" […] ")
	firstChar=type.charAt(0)
	if (!(firstChar === firstChar.toUpperCase()) || !!firstChar.match(/^[,;]/)) {
	type="[…] "+type
	}
	lastChar=type.charAt(type.length-1)
	if (!lastChar.match(/[.;?]/)) {
	type = type +" […]"
	}
	return type
};

function* groupResults(list, groupKey) {
    let test = groupKey ;
    let groups = new Map();
    for (let item of list) {
        let group = groups.get(item._source[test]) ?? [];
        group.push(item);
        groups.set(item._source[test], group);
    }
    for (let [test, items] of groups) {
        yield { [groupKey] : test, items };
    }
};

//                  //
// L'autocomplétion //
//                  //

document.querySelectorAll(".autocomplete-input").forEach((input, index) => {
    resetFocus();
    enableAutocomplete(input, index);
})

document.addEventListener("click", event => {
    closeList();
});

function enableAutocomplete(input, index) {
    input.addEventListener("input", event => {
        closeList();
        let searchedIndex = input.dataset.index; // valeur de <input data-index>
        let searchedString = input.value; // valeur de ce qui est renseigné quand l'utilisateur tape une lettre ("c" pour charte)
        let queryDetails = Object.fromEntries([["query", searchedString], ["slop", 3]])
        let query = Object.fromEntries([[searchedIndex, queryDetails]]);

        executeOptionsQuery(query).then(results => {
            if (results.hits.hits.length != 0) {
                let options = results.hits.hits;
                displayOptions(input, options)
            }   
        });
    })

    /*execute a function presses a key on the keyboard:*/
    input.addEventListener("keydown", function (e) {
        let currentIndex = String(index)
        var currentFocus = Number(currentFocusList.get(currentIndex))

        var x = document.getElementById("autocomplete-list");
        if (x) x = x.getElementsByTagName("li");
        if (e.keyCode == 40) {
            resetFocus();
            currentFocus++;
            currentFocusList.set(currentIndex, currentFocus);
            addActive(x, currentIndex, currentFocus);
        } else if (e.keyCode == 38) {
            resetFocus();
            currentFocus--;
            currentFocusList.set(currentIndex, currentFocus);
            addActive(x, currentIndex, currentFocus);
        } else if (e.keyCode == 13) {
            e.preventDefault();
            e.stopPropagation();
            if (currentFocus > -1) {
                if (x) x[currentFocus].click();
                resetFocus();
            } else {
                prepareSearch();
            }
        }
    });
}


async function executeOptionsQuery(query) {
    // baseQuery = "http://localhost:9200/scripta_autocomplete/_search"
    // localhost à remplacer pour mise en ligne :
    baseQuery = "scripta_autocomplete/_search"

    let queryParameters = {
        track_total_hits: true,
        query: {
            match_phrase_prefix:
                query
        }
    }

    const queryInit = {
        method: "POST",
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(queryParameters)
    };


    const response = await fetch(baseQuery, queryInit);
    let results = await response.json();
    return results
};

function addActive(x, currentIndex, currentFocus) {
    if (!x) return false;
    removeActive(x);
    if (currentFocus >= x.length) {
        currentFocus = 0;
        currentFocusList.set(currentIndex, currentFocus);
    }
    if (currentFocus < 0) {
        currentFocus = x.length - 1;
        currentFocusList.set(currentIndex, currentFocus);
    }
    x[currentFocus].classList.add("autocomplete-active");
}

function removeActive(x) {
    for (var i = 0; i < x.length; i++) {
        x[i].classList.remove("autocomplete-active");
    }
}

function resetFocus() {
    document.querySelectorAll(".autocomplete-input").forEach((input, index) => {
        currentFocusList.set(String(index), -1)
    })
}

function closeList() {
    let currentList = document.querySelector("#autocomplete-list");
    if (currentList != null) {
        currentList.remove();
    }
}

function displayOptions(input, options) {
    closeList();

    let optionsList = document.createElement("ul");
    optionsList.id = "autocomplete-list";

    options.forEach(option => {
        let listItem = document.createElement("li");
        listItem.classList.add("autocomplete-item");
        // Object.keys(jsonObj) will create an array of the keys of the object which 
        // can be accessed using [] notation. [0] is the first item in the array.
        // Adding this as the key lookup for the jsonObject (inside its own square brackets)
        // is essentially saying "make an array of all the keys in the object, give me the
        // first of these, now look up the values for that key, in the original object".
        listItem.innerHTML = option._source[Object.keys(option._source)[0]];
        optionsList.appendChild(listItem);
        listItem.addEventListener("click", function () {
            let optionIndex = input.dataset.index;
            let selectedOptionContainer = document.createElement("span");
            selectedOptionContainer.classList.add("suggested-value");
            selectedOptionContainer.setAttribute("data-index", optionIndex);
            selectedOptionContainer.setAttribute("data-value", listItem.textContent);
            selectedOptionContainer.innerHTML = listItem.textContent;
            let closeButton = document.createElement("button");
            closeButton.classList.add("closeBtn");
            closeButton.innerHTML = "x";
            selectedOptionContainer.append(closeButton);
            input.parentNode.append(selectedOptionContainer);
            input.value = "";
            closeList();
        })
    });

    input.parentElement.append(optionsList);

};

