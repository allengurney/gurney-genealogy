import {Plugin} from '../../core/ui/js/Plugin.js';
const PLUGIN_NAME='thesauri';

class thesauriPlugin extends Plugin{
    constructor(name) {
        super(name);
        const parser = new DOMParser();   

        let node =
        parser.parseFromString(
        '<div id="thesauriPDN" class="fenetreModale" style="display: none;" tabindex="-1" role="dialog">' +
        '<div class="fenetreModale-content">' +
        '<div class="fenetreModale-header" style="text-align:right">' +
        '<span class="close" id="closemodal">X</span>' +
        '</div>' +
        '<div class="fenetreModale-bodySection">' +
        '</div>' +
        '</div>' +                
        '</div>',
        "text/html")
        .documentElement.querySelector('#thesauriPDN');
        
        document.body.append(document.importNode(node, true));
        document.getElementById('thesauriPDN').style.display = 'none';
    
        let fermer = document.getElementById("closemodal");
        fermer.setAttribute("onclick", "document.getElementById('thesauriPDN').style.display='none'")
    
    }

    //DEBUT fenêtre modale : pour afficher les notices personnes dans une fenêtre modale
    showInWindow(thesaurus, target) {

        // Get the modal
        var modal = document.getElementById("thesauriPDN");
                // Get the <span> element that closes the modal
        var span = document.getElementsByClassName("close")[0];
        
        var url = "https://thesauri.unicaen.fr/autorites/" + thesaurus + "/fragment_html/" + target + ".html?wrap=false";
        console.log(url)
        fetch(url,{credentials: "include"}).then(res => res.text()).then(text => {
            document.querySelector(".fenetreModale-bodySection").innerHTML = text;
            modal.style.display = "block";
            if(modal.querySelector(".person")){
            var toggler = modal.getElementsByClassName("togglerInfobulle");
            var i;
            let cpt = 0;
            for (i = 0; i < toggler.length; i++) {
                cpt++;
                let sup = document.createElement("sup");
                toggler[i].appendChild(sup);
                sup.innerHTML = cpt;
                sup.setAttribute("id","appelNote"+cpt);
            }
            } 
            })

        // When the user clicks on <span> (x), close the modal
        span.onclick = function() {
            modal.style.display = "none";
        }
        
        // When the user clicks anywhere outside of the modal, close it
        window.onclick = function(event) {
            if (event.target == modal) {
            modal.style.display = "none";
            }
        }

    }
}

